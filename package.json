{
  "name": "orientim-protected-swap-repo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orientimhq/orientim-protected-swap.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:fuzz": "vitest run packages/verifier/test/property.test.ts packages/verifier/test/extensions.test.ts packages/verifier/test/slippage.property.test.ts packages/verifier/test/extremes.property.test.ts packages/verifier/test/mutation.property.test.ts --mode fuzz",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node tools/build-skill.ts",
    "check": "node tools/build-skill.ts --check"
  },
  "devDependencies": {
    "@solana-program/compute-budget": "0.18.1",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.3.0",
    "@types/node": "26.6.1",
    "fast-check": "4.10.1",
    "rolldown": "1.2.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
